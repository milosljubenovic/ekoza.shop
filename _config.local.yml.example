# Local-only overrides for Jekyll. Copy to _config.local.yml (gitignored) and
# fill in the real values. Build commands pass both files to Jekyll, so values
# here override the placeholders in _config.yml.
#
#   bundle exec jekyll serve --config _config.yml,_config.local.yml
#   bundle exec jekyll build --config _config.yml,_config.local.yml
#
# Important: the previous value of chat.shared_secret was committed to git
# history and must be considered public. Rotate it on the chat-gateway before
# putting a new one here. Even after rotation, this value is inlined into
# assets/js/chat.js when the site is built and served to every visitor, so it
# is not a real secret -- the gateway still needs Origin/rate-limit checks.

chat:
  shared_secret: "PUT_REAL_SECRET_HERE"
